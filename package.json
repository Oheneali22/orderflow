{
  "name": "orderflow",
  "version": "1.0.0",
  "private": true,
  "description": "A small asynchronous order-processing system for DevOps learning.",
  "type": "module",
  "engines": {
    "node": ">=20 <23"
  },
  "scripts": {
    "start:api": "node src/api/server.js",
    "start:worker": "node src/worker/server.js",
    "db:migrate": "node src/database/migrate.js",
    "lint": "eslint .",
    "test": "node --test --test-concurrency=1",
    "test:coverage": "node --test --test-concurrency=1 --experimental-test-coverage"
  },
  "dependencies": {
    "express": "5.1.0",
    "pg": "8.16.3",
    "pino": "9.9.4",
    "prom-client": "15.1.3",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "eslint": "9.34.0",
    "supertest": "7.1.4"
  }
}
