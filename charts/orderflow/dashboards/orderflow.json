{
  "annotations": {"list": []},
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "reqps"}},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 0},
      "id": 1,
      "targets": [{"expr": "sum(rate(orderflow_api_http_request_duration_seconds_count{namespace=\"orderflow\"}[5m]))", "legendFormat": "requests"}],
      "title": "API request rate",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 0},
      "id": 2,
      "targets": [{"expr": "sum(rate(orderflow_api_http_request_duration_seconds_count{namespace=\"orderflow\",status_code=~\"5..\"}[5m])) / clamp_min(sum(rate(orderflow_api_http_request_duration_seconds_count{namespace=\"orderflow\"}[5m])), 0.001)", "legendFormat": "5xx ratio"}],
      "title": "API error ratio",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "s"}},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 0},
      "id": 3,
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(orderflow_api_http_request_duration_seconds_bucket{namespace=\"orderflow\"}[5m])))", "legendFormat": "p95"}],
      "title": "API p95 latency",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "ops"}},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "id": 4,
      "targets": [{"expr": "sum(rate(orderflow_worker_jobs_processed_total{namespace=\"orderflow\"}[5m]))", "legendFormat": "jobs"}],
      "title": "Worker throughput",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "short"}},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "id": 5,
      "targets": [{"expr": "sum by (service) (up{namespace=\"orderflow\"})", "legendFormat": "{{service}}"}],
      "title": "Healthy targets",
      "type": "timeseries"
    }
  ],
  "schemaVersion": 41,
  "tags": ["orderflow", "portfolio"],
  "templating": {"list": []},
  "time": {"from": "now-6h", "to": "now"},
  "title": "OrderFlow service overview",
  "uid": "orderflow-overview",
  "version": 1
}
